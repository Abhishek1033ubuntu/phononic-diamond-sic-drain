# ==============================================================================
# NEMD Simulation: CVD Diamond / 4H-SiC Heterostructure Interface
# Author: Abhishek Singh (ORCID: 0009-0004-6913-096X)
# ==============================================================================

units           metal
atom_style      atomic
dimension       3
boundary        p p p

# Simulation Box (35.67 x 35.67 x 80.0 Angstroms)
region          simbox block 0 35.67 0 35.67 0 80.0
create_box      3 simbox

# 1. CVD Diamond Substrate Layer (Type 1: C_diamond)
region          reg_diamond block INF INF INF INF 0.0 39.5 units box
lattice         diamond 3.567
create_atoms    1 region reg_diamond

# 2. 4H-SiC Active Layer (Type 2: Si, Type 3: C_SiC)
region          reg_semic block INF INF INF INF 40.2 80.0 units box
lattice         diamond 4.36
create_atoms    2 region reg_semic basis 1 2 basis 2 3

mass            1 12.011  # C_diamond
mass            2 28.085  # Si
mass            3 12.011  # C_SiC

# Solid-State Lennard-Jones Parameters
pair_style      lj/cut 4.0
pair_coeff      1 1 1.20 1.80  # C-C Diamond backbone
pair_coeff      2 2 0.80 2.20  # Si-Si binding
pair_coeff      3 3 1.00 1.80  # C-C SiC binding
pair_coeff      1 2 0.85 2.00  # C_diamond - Si bridge
pair_coeff      1 3 1.10 1.80  # C_diamond - C_SiC coupling
pair_coeff      2 3 0.90 2.00  # Si-C internal bond

delete_atoms    overlap 1.2 all all

# Thermal Reservoirs
region          reg_hot  block INF INF INF INF 2.0 10.0 units box
region          reg_cold block INF INF INF INF 70.0 78.0 units box

group           grp_hot  region reg_hot
group           grp_cold region reg_cold

velocity        all create 600.0 12345 mom yes rot yes dist gaussian
minimize        1.0e-5 1.0e-7 2000 20000

# NVT Relaxation
fix             f_equil all nvt temp 600.0 600.0 0.1
timestep        0.0005
run             15000
unfix           f_equil

# NEMD Production Run
fix             f_nve all nve
fix             f_hot grp_hot langevin 650.0 650.0 0.1 54321 tally yes
fix             f_cold grp_cold langevin 550.0 550.0 0.1 98765 tally yes

compute         c_chunk all chunk/atom bin/1d z lower 0.05 units reduced
fix             f_spatial all ave/chunk 10 100 2000 c_chunk temp file temp_profile_diamond.profile

thermo          1000
thermo_style    custom step temp epair etotal press

run             30000
