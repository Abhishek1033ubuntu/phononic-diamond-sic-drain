# 6. Kapitza Post-Processing Cell
cell6_text = """# Step 3: Extract Interfacial Temperature Drop and Kapitza Resistance
import numpy as np
import matplotlib.pyplot as plt

chunk_data = []
with open('temp_profile_diamond.profile', 'r') as f:
    for line in f:
        line = line.strip()
        if line.startswith('#') or not line:
            continue
        parts = line.split()
        if len(parts) == 4:
            try:
                chunk_data.append([float(x) for x in parts])
            except ValueError:
                continue

data = np.array(chunk_data)
num_chunks = len(np.unique(data[:, 0]))
final_frame = data[-num_chunks:]

z_coords = final_frame[:, 1]
temp_K = final_frame[:, 3]

diamond_mask = (z_coords >= 0.15) & (z_coords <= 0.45)
sic_mask     = (z_coords >= 0.52) & (z_coords <= 0.82)

fit_diamond = np.polyfit(z_coords[diamond_mask], temp_K[diamond_mask], 1)
fit_sic     = np.polyfit(z_coords[sic_mask], temp_K[sic_mask], 1)

t_diamond = fit_diamond[0] * 0.5 + fit_diamond[1]
t_sic     = fit_sic[0] * 0.5 + fit_sic[1]
delta_t   = t_diamond - t_sic

j_flux = 1.5e9
r_k = delta_t / j_flux
g_conductance = (1.0 / r_k) / 1e6

print(f'Extrapolated ΔT : {delta_t:.2f} K')
print(f'Kapitza Resistance (R_k) : {r_k:.3e} m²·K/W')
print(f'Thermal Conductance (G)  : {g_conductance:.2f} MW/m²·K')

plt.figure(figsize=(8, 5))
plt.plot(z_coords, temp_K, 'o-', label='NEMD Temperature Profile')
plt.axvline(x=0.5, color='red', linestyle='--', label='Interface (Φ-Node)')
plt.plot(z_coords[diamond_mask], fit_diamond[0]*z_coords[diamond_mask] + fit_diamond[1], 'r--', label='Diamond Fit')
plt.plot(z_coords[sic_mask], fit_sic[0]*z_coords[sic_mask] + fit_sic[1], 'g--', label='4H-SiC Fit')
plt.xlabel('Normalized Z Coordinate')
plt.ylabel('Temperature (K)')
plt.title('NEMD Thermal Profile: CVD Diamond / 4H-SiC Heterostructure')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()"""

