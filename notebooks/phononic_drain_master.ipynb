            "source": [
                "# Step 3: Extract Interfacial Temperature Drop and Kapitza Resistance\n",
                "import numpy as np\n",
                "import matplotlib.pyplot as plt\n\n",
                "chunk_data = []\n",
                "with open('temp_profile_diamond.profile', 'r') as f:\n",
                "    for line in f:\n",
                "        line = line.strip()\n",
                "        if line.startswith('#') or not line:\n",
                "            continue\n",
                "        parts = line.split()\n",
                "        if len(parts) == 4:\n",
                "            try:\n",
                "                chunk_data.append([float(x) for x in parts])\n",
                "            except ValueError:\n",
                "                continue\n\n",
                "data = np.array(chunk_data)\n",
                "num_chunks = len(np.unique(data[:, 0]))\n",
                "final_frame = data[-num_chunks:]\n\n",
                "z_coords = final_frame[:, 1]\n",
                "temp_K = final_frame[:, 3]\n\n",
                "diamond_mask = (z_coords >= 0.15) & (z_coords <= 0.45)\n",
                "sic_mask     = (z_coords >= 0.52) & (z_coords <= 0.82)\n\n",
                "fit_diamond = np.polyfit(z_coords[diamond_mask], temp_K[diamond_mask], 1)\n",
                "fit_sic     = np.polyfit(z_coords[sic_mask], temp_K[sic_mask], 1)\n\n",
                "t_diamond = fit_diamond[0] * 0.5 + fit_diamond[1]\n",
                "t_sic     = fit_sic[0] * 0.5 + fit_sic[1]\n",
                "delta_t   = t_diamond - t_sic\n\n",
                "j_flux = 1.5e9\n",
                "r_k = delta_t / j_flux\n",
                "g_conductance = (1.0 / r_k) / 1e6\n\n",
                "print(f'Extrapolated ΔT : {delta_t:.2f} K')\n",
                "print(f'Kapitza Resistance (R_k) : {r_k:.3e} m²·K/W')\n",
                "print(f'Thermal Conductance (G)  : {g_conductance:.2f} MW/m²·K')\n\n",
                "plt.figure(figsize=(8, 5))\n",
                "plt.plot(z_coords, temp_K, 'o-', label='NEMD Temperature Profile')\n",
                "plt.axvline(x=0.5, color='red', linestyle='--', label='Interface (Φ-Node)')\n",
                "plt.plot(z_coords[diamond_mask], fit_diamond[0]*z_coords[diamond_mask] + fit_diamond[1], 'r--', label='Diamond Fit')\n",
                "plt.plot(z_coords[sic_mask], fit_sic[0]*z_coords[sic_mask] + fit_sic[1], 'g--', label='4H-SiC Fit')\n",
                "plt.xlabel('Normalized Z Coordinate')\n",
                "plt.ylabel('Temperature (K)')\n",
                "plt.title('NEMD Thermal Profile: CVD Diamond / 4H-SiC Heterostructure')\n",
                "plt.legend()\n",
                "plt.grid(True, alpha=0.3)\n",
                "plt.show()"
            ]
