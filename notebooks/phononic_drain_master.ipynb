                "r = np.linspace(0, 1.0, 100)\n",
                "z = np.linspace(0, 0.5, 50)\n",
                "R, Z = np.meshgrid(r, z)\n\n",
                "r_spot = 0.15\n",
                "T_core = 300 + (485.15 - 300) * np.exp(-(R / r_spot)**2) * (Z / 0.5)**2\n\n",
                "plt.figure(figsize=(9, 5))\n",
                "plt.contourf(R, Z, T_core, 50, cmap='inferno')\n",
                "plt.colorbar(label='Temperature (K)')\n",
                "plt.title('Patterned h-BN Substrate: Localized 2D Radial Thermal Forwarding', fontweight='bold')\n",
                "plt.xlabel('Radial Distance r (mm)')\n",
                "plt.ylabel('Substrate Thickness z (mm)')\n",
                "plt.grid(True, alpha=0.2, linestyle='--')\n",
                "plt.show()"
            ]
