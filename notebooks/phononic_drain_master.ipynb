                "## Section 4: Analog Signal Integrity & 50 GHz Dynamic EMI Verification"
            ]
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Step 5: Simulate Analog Signal Output under 50 GHz EMI Noise\n",
                "fs = 1.0e6\n",
                "t = np.linspace(0, 2.0, int(fs * 2.0))\n",
                "v_ideal = 0.5 + 4.0 * np.maximum(0, np.sin(2 * np.pi * 1.0 * t))\n\n",
                "thermal_drift = 0.84 * (1 - np.exp(-t / 0.4))\n",
                "noise = 0.65 * np.sin(2 * np.pi * 50e3 * t) + 0.25 * np.random.normal(0, 1, len(t))\n\n",
                "v_unshielded = v_ideal + thermal_drift + noise\n",
                "v_dsp = np.roll(v_unshielded, int(0.015 * fs))\n",
                "v_dsp = np.convolve(v_dsp, np.ones(500)/500, mode='same')\n",
                "v_hbn_shielded = v_ideal + (noise / 125.0)\n\n",
                "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 7), sharex=True)\n",
                "ax1.plot(t, v_unshielded, color='#e74c3c', alpha=0.5, label='Unshielded Node')\n",
                "ax1.plot(t, v_dsp, color='#f39c12', linestyle='--', label='DSP Filtered (15ms delay)')\n",
                "ax1.plot(t, v_hbn_shielded, color='#2ecc71', label='h-BN Physical Shield')\n",
                "ax1.plot(t, v_ideal, color='#2c3e50', linestyle=':', label='True Input Target')\n",
                "ax1.set_ylabel('Analog Output (V)')\n",
                "ax1.set_title('Analog Signal Integrity Verification (0.5V - 4.5V Range)', fontweight='bold')\n",
                "ax1.grid(True, alpha=0.3)\n",
                "ax1.legend()\n\n",
                "ax2.plot(t, v_unshielded - v_ideal, color='#e74c3c', alpha=0.5, label='Unshielded Error')\n",
                "ax2.plot(t, v_dsp - v_ideal, color='#f39c12', label='DSP Residual Error')\n",
                "ax2.plot(t, v_hbn_shielded - v_ideal, color='#2ecc71', label='h-BN Residual Error')\n",
                "ax2.set_xlabel('Time (seconds)')\n",
                "ax2.set_ylabel('Error Residual (V)')\n",
                "ax2.set_title('Signal Distortion & Baseline Offset Error Residuals', fontweight='bold')\n",
                "ax2.grid(True, alpha=0.3)\n",
                "ax2.legend()\n\n",
                "plt.tight_layout()\n",
