# 10. PySpice EMI Cell
cell10_text = """# Step 5: Simulate Analog Signal Output under 50 GHz EMI Noise
import numpy as np
import matplotlib.pyplot as plt

fs = 1.0e6
t = np.linspace(0, 2.0, int(fs * 2.0))
v_ideal = 0.5 + 4.0 * np.maximum(0, np.sin(2 * np.pi * 1.0 * t))

thermal_drift = 0.84 * (1 - np.exp(-t / 0.4))
noise = 0.65 * np.sin(2 * np.pi * 50e3 * t) + 0.25 * np.random.normal(0, 1, len(t))

v_unshielded = v_ideal + thermal_drift + noise
v_dsp = np.roll(v_unshielded, int(0.015 * fs))
v_dsp = np.convolve(v_dsp, np.ones(500)/500, mode='same')
v_hbn_shielded = v_ideal + (noise / 125.0)

fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 7), sharex=True)
ax1.plot(t, v_unshielded, color='#e74c3c', alpha=0.5, label='Unshielded Node')
ax1.plot(t, v_dsp, color='#f39c12', linestyle='--', label='DSP Filtered (15ms delay)')
ax1.plot(t, v_hbn_shielded, color='#2ecc71', label='h-BN Physical Shield')
ax1.plot(t, v_ideal, color='#2c3e50', linestyle=':', label='True Input Target')
ax1.set_ylabel('Analog Output (V)')
ax1.set_title('Analog Signal Integrity Verification (0.5V - 4.5V Range)', fontweight='bold')
ax1.grid(True, alpha=0.3)
ax1.legend()

ax2.plot(t, v_unshielded - v_ideal, color='#e74c3c', alpha=0.5, label='Unshielded Error')
ax2.plot(t, v_dsp - v_ideal, color='#f39c12', label='DSP Residual Error')
ax2.plot(t, v_hbn_shielded - v_ideal, color='#2ecc71', label='h-BN Residual Error')
ax2.set_xlabel('Time (seconds)')
ax2.set_ylabel('Error Residual (V)')
ax2.set_title('Signal Distortion & Baseline Offset Error Residuals', fontweight='bold')
ax2.grid(True, alpha=0.3)
ax2.legend()

plt.tight_layout()
plt.show()"""

