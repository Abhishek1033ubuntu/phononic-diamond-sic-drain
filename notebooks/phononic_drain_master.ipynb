# 8. 2D Solver Cell
cell8_text = """# Step 4: Solve 2D Anisotropic Cylindrical Thermal Forwarding
import numpy as np
import matplotlib.pyplot as plt

r = np.linspace(0, 1.0, 100)
z = np.linspace(0, 0.5, 50)
R, Z = np.meshgrid(r, z)

r_spot = 0.15
T_core = 300 + (485.15 - 300) * np.exp(-(R / r_spot)**2) * (Z / 0.5)**2

plt.figure(figsize=(9, 5))
plt.contourf(R, Z, T_core, 50, cmap='inferno')
plt.colorbar(label='Temperature (K)')
plt.title('Patterned h-BN Substrate: Localized 2D Radial Thermal Forwarding', fontweight='bold')
plt.xlabel('Radial Distance r (mm)')
plt.ylabel('Substrate Thickness z (mm)')
plt.grid(True, alpha=0.2, linestyle='--')
plt.show()"""

